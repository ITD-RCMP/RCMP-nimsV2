# MySQL — pick ONE method:
#
# Method A (recommended on Plesk): single connection URL
# DATABASE_URL=mysql://plesk_db_user:plesk_db_password@127.0.0.1:3306/plesk_db_name
#
# Method B: separate variables (use 127.0.0.1, not localhost)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=your_plesk_db_user
MYSQL_PASSWORD=your_plesk_db_password
MYSQL_DATABASE=your_plesk_db_name
# MYSQL_SOCKET=/var/run/mysqld/mysqld.sock

# Microsoft Entra ID (Azure AD) — single-tenant SSO
AZURE_TENANT_ID=your-directory-tenant-id
AZURE_CLIENT_ID=your-application-client-id
AZURE_CLIENT_SECRET=your-client-secret-value
AZURE_REDIRECT_URI=http://localhost:8080/api/auth/microsoft/callback
# Production (must match Azure App registration exactly):
# AZURE_REDIRECT_URI=https://nims.rcmp.edu.my/api/auth/microsoft/callback
AZURE_ALLOWED_EMAIL_DOMAINS=

# Notification email (Microsoft 365 / Outlook SMTP) — system mailbox only, not stored in DB
# Use an app password if the account has MFA: https://account.microsoft.com/security
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-notifications@yourorg.onmicrosoft.com
# SMTP_PASSWORD=your-mailbox-password-or-app-password
# SMTP_FROM=your-notifications@yourorg.onmicrosoft.com
# SMTP_FROM_NAME=NIMS

# --- Local dev with Mailpit (see .env.mailpit.example and config/mailpit.env) ---
# npm run mailpit  →  UI http://localhost:8025  SMTP localhost:1025
SMTP_MAILPIT=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=nims.rcmp@unikl.edu.my
SMTP_PASSWORD=
SMTP_FROM=nims.rcmp@unikl.edu.my
SMTP_FROM_NAME=NIMS

# Overdue return reminder emails (daily 09:00 Asia/Kuala_Lumpur)
# First send the calendar day after return_date; repeats daily while assets stay checked out.
# Sent only to the overdue requester. Requires outstanding checked-out assets.
#
# Production (node .output/server/index.mjs): set OVERDUE_EMAIL_SCHEDULER=true so the
# Nitro plugin starts the in-process daily timer. Without it, nothing auto-sends.
# Alternative: external cron POST /api/cron/overdue-return-emails with Bearer CRON_SECRET
# or: npm run overdue-emails
# OVERDUE_EMAIL_TZ=Asia/Kuala_Lumpur
# OVERDUE_EMAIL_HOUR=9
# OVERDUE_EMAIL_MINUTE=0
# OVERDUE_EMAIL_SCHEDULER=true
# CRON_SECRET=change-me-for-post-api-cron-overdue-return-emails

# OAuth scopes requested at sign-in (must include User.Read for Graph profile)
AZURE_OAUTH_SCOPES=openid profile email offline_access User.Read
# Comma-separated redirect URIs for React Native / mobile OAuth (must match Azure app registration)
# AZURE_MOBILE_REDIRECT_URIS=nims://auth/callback,msauth.com.yourorg.nims://auth

# REST API (React Native mobile app) — JWT signing secret (use a long random string in production)
API_JWT_SECRET=change-me-to-a-long-random-secret

# Web app session cookie — encrypts/signs the HttpOnly session (min 32 chars, use a long random string)
SESSION_SECRET=change-me-to-a-different-long-random-secret

# # Set to "true" to allow the dev-only "Login as ..." shortcuts (in addition to NODE_ENV !== production)
# ENABLE_DEV_LOGIN=true

# OpenRouter (TanStack AI) — https://openrouter.ai/keys
# Ask AI keeps this model. Staff chat uses read-only server tools (see backend/server/admin/admin-prompt-ai.md).
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=poolside/laguna-xs-2.1:free
OPENROUTER_HTTP_REFERER=http://localhost:8080
# Production:
# OPENROUTER_HTTP_REFERER=https://nims.rcmp.edu.my
OPENROUTER_APP_TITLE=NIMS

# Ask AI messy-text search (Slice 3). Chat model above stays unchanged.
# Leave unset to keep Ask AI working without semantic search.
# After setting this, run: npm run ai:reindex
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_EMBEDDING_API_KEY=

# Microsoft Graph API — profile fetch for Settings page
AZURE_GRAPH_API_URL=https://graph.microsoft.com/v1.0
AZURE_GRAPH_ME_PATH=/me
AZURE_GRAPH_ME_SELECT=id,displayName,mail,userPrincipalName,jobTitle,officeLocation

# WhatsApp Cloud API (Meta) — https://developers.facebook.com/docs/whatsapp/cloud-api
# Required to send: WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID
# WHATSAPP_ACCESS_TOKEN=EAAB...
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_API_BASE_URL=https://graph.facebook.com
# Webhook verification (only if you expose a webhook endpoint later)
# WHATSAPP_VERIFY_TOKEN=change-me-webhook-verify-token
# WHATSAPP_APP_SECRET=your-meta-app-secret
